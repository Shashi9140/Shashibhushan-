// Personal AI Assistant
function addAIMessage(text, who){
  const chat=document.getElementById("aiChat");
  const div=document.createElement("div");
  div.className="ai-msg "+(who==="user"?"ai-user":"ai-bot");
  div.textContent=text;
  chat.appendChild(div);
  chat.scrollTop=chat.scrollHeight;
}

function toggleAIKey(){
  const box=document.getElementById("aiKeyBox");
  box.style.display=box.style.display==="block"?"none":"block";
}

function localAIAnswer(q){
  const x=q.toLowerCase();
  if(x.includes("cpu")) return "CPU का पूरा नाम Central Processing Unit है। यह instructions को process करता है और computer के processing कार्यों का मुख्य हिस्सा संभालता है।";
  if(x.includes("ram")) return "RAM का पूरा नाम Random Access Memory है। यह volatile/temporary memory है, जिसमें currently running programs और data रखे जाते हैं।";
  if(x.includes("html")) return "HTML का पूरा नाम HyperText Markup Language है। इसका उपयोग webpage की structure बनाने के लिए किया जाता है।";
  if(x.includes("css")) return "CSS का पूरा नाम Cascading Style Sheets है। इसका उपयोग webpage के design, colors, fonts, spacing और layout के लिए किया जाता है।";
  if(x.includes("javascript") || x.includes("java script")) return "JavaScript webpage को interactive बनाता है, जैसे buttons, quiz, calculations और dynamic content।";
  if(x.includes("internet")) return "Internet interconnected networks का global network है। इसका उपयोग websites, email, communication और online services के लिए होता है।";
  if(x.includes("cyber") || x.includes("security")) return "Cyber Security में devices, accounts, networks और data को online threats से सुरक्षित रखना शामिल है। Strong passwords, 2FA और phishing से सावधानी जरूरी है।";
  if(x.includes("upi")) return "UPI का पूरा नाम Unified Payments Interface है। यह digital payments और bank-to-bank transfers के लिए इस्तेमाल होता है। अपना UPI PIN/OTP किसी से share न करें।";
  if(x.includes("spreadsheet") || x.includes("excel") || x.includes("calc")) return "Spreadsheet में rows और columns में data रखा जाता है। Formulas और functions से calculations की जाती हैं; LibreOffice Calc इसका उदाहरण है।";
  if(x.includes("email")) return "Email electronic messages भेजने और प्राप्त करने की सुविधा है। To, CC, BCC, Subject और Attachment इसके common parts हैं।";
  if(x.includes("hello") || x.includes("hi") || x.includes("नमस्ते")) return "नमस्ते! 👋 CCC या Computer से जुड़ा कोई भी सवाल पूछिए।";
  return "इस सवाल का offline answer मेरे built-in CCC knowledge में नहीं मिला। अगर आप online general AI answer चाहते हैं, तो इस website को secure backend/API से connect करना होगा।";
}

async function askPersonalAI(){
  const input=document.getElementById("aiInput");
  const q=input.value.trim();
  if(!q) return;

  addAIMessage(q,"user");
  input.value="";

  const key=document.getElementById("aiKey").value.trim();
  if(!key){
    setTimeout(()=>addAIMessage(localAIAnswer(q),"bot"),250);
    return;
  }

  addAIMessage("AI सोच रहा है...","bot");
  const chat=document.getElementById("aiChat");

  try{
    // OpenAI-compatible endpoint. Replace with your own secure backend endpoint in production.
    const response=await fetch("https://api.openai.com/v1/chat/completions",{
      method:"POST",
      headers:{
        "Content-Type":"application/json",
        "Authorization":"Bearer "+key
      },
      body:JSON.stringify({
        model:"gpt-4o-mini",
        messages:[
          {role:"system",content:"You are a helpful Personal AI Assistant for a CCC computer-learning website. Answer clearly, simply, and preferably in Hindi when the user asks in Hindi."},
          {role:"user",content:q}
        ],
        temperature:0.4
      })
    });

    if(!response.ok) throw new Error("API request failed");
    const data=await response.json();
    chat.lastElementChild.remove();
    addAIMessage(data.choices?.[0]?.message?.content || "AI ने कोई answer नहीं दिया।","bot");
  }catch(err){
    chat.lastElementChild.remove();
    addAIMessage("Online AI से connection नहीं हो पाया। API key/Internet/API access check करें। फिलहाल: "+localAIAnswer(q),"bot");
  }
}

