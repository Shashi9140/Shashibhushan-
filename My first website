const form=document.getElementById("quizForm");
form.innerHTML=questions.map((q,i)=>`<div class="question"><h3>${i+1}. ${q[0]}</h3>${q[1].map((o,j)=>`<label class="option"><input type="radio" name="q${i}" value="${String.fromCharCode(65+j)}"> ${o}</label>`).join("")}</div>`).join("");

function complete(n,btn){
 let a=JSON.parse(localStorage.getItem("cccDone")||"[]");
 if(a.includes(n)){a=a.filter(x=>x!==n);btn.classList.remove("done");btn.textContent="Mark as Complete"}
 else{a.push(n);btn.classList.add("done");btn.textContent="✓ Completed"}
 localStorage.setItem("cccDone",JSON.stringify(a));updateProgress();
}
function updateProgress(){
 let a=JSON.parse(localStorage.getItem("cccDone")||"[]"),p=Math.round(a.length/10*100);
 document.getElementById("doneCount").textContent=a.length;
 document.getElementById("fill").style.width=p+"%";
 document.getElementById("pct").textContent=p+"% completed";
 document.querySelectorAll(".complete").forEach(b=>{
  let n=Number(b.dataset.id);
  if(a.includes(n)){b.classList.add("done");b.textContent="✓ Completed"}
 });
}
function searchCards(){
 let s=document.getElementById("search").value.toLowerCase();
 document.querySelectorAll(".card").forEach(c=>c.classList.toggle("hide",!(c.dataset.search||"").toLowerCase().includes(s)));
}
function submitQuiz(){
 let score=0,answered=0;
 questions.forEach((q,i)=>{
  let x=document.querySelector(`input[name="q${i}"]:checked`);
  if(x){answered++;if(x.value===q[2])score++}
 });
 if(answered<20){alert("कृपया सभी 20 questions का answer दें।");return}
 let p=score*5;
 document.getElementById("score").textContent=`आपका Score: ${score}/20 (${p}%)`;
 document.getElementById("message").textContent=p>=80?"बहुत अच्छा!":p>=60?"अच्छा प्रयास! गलत topics को दोबारा पढ़ें।":"Topics को फिर से पढ़कर quiz दोबारा attempt करें।";
 document.getElementById("result").style.display="block";
 document.getElementById("result").scrollIntoView({behavior:"smooth",block:"center"});
}
